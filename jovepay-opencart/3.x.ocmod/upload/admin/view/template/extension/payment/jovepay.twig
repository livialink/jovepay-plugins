{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-status" data-toggle="tab">{{ tab_order_status }}</a></li>
          </ul>
          <div class="tab-content">
              <div class="tab-pane active" id="tab-general">
                <div class="form-group required">
                  <label class="col-sm-2 control-label" for="entry-title">{{ entry_title }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_jovepay_title" value="{{ payment_jovepay_title }}" placeholder="{{ entry_title }}" id="entry-title" class="form-control"/>
                    {% if error_title %}
                    <div class="text-danger">{{ error_title }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="form-group" required>
                  <label class="col-sm-2 control-label" for="input-mode">{{ entry_mode }}</label>
                  <div class="col-sm-10">
                    <select name="payment_jovepay_mode" id="input-mode" class="form-control">
                      {% if payment_jovepay_mode %}
                      <option value="1" selected="selected">{{ entry_mode_mainnet }}</option>
                      <option value="0">{{ entry_mode_testnet }}</option>
                      {% else %}
                      <option value="1">{{ entry_mode_mainnet }}</option>
                      <option value="0" selected="selected">{{ entry_mode_testnet }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
                <div class="form-group" required>
                  <label class="col-sm-2 control-label" for="input-theme">{{ entry_theme }}</label>
                  <div class="col-sm-10">
                    <select name="payment_jovepay_theme" id="input-theme" class="form-control">
                      {% if payment_jovepay_theme == "light" %}
                      <option value="light" selected="selected">{{ entry_theme_light }}</option>
                      <option value="dark">{{ entry_theme_dark }}</option>
                      {% else %}
                      <option value="light">{{ entry_theme_light }}</option>
                      <option value="dark" selected="selected">{{ entry_theme_dark }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
                <div class="form-group required">
                  <label class="col-sm-2 control-label" for="entry-api_key">{{ entry_api_key }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_jovepay_api_key" value="{{ payment_jovepay_api_key }}" placeholder="{{ entry_api_key }}" id="entry-api_key" class="form-control"/>
                    {% if error_api_key %}
                    <div class="text-danger">{{ error_api_key }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="form-group required">
                  <label class="col-sm-2 control-label" for="entry-ipn_secret">{{ entry_ipn_secret }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_jovepay_ipn_secret" value="{{ payment_jovepay_ipn_secret }}" placeholder="{{ entry_ipn_secret }}" id="entry-ipn_secret" class="form-control"/>
                    {% if error_ipn_secret %}
                    <div class="text-danger">{{ error_ipn_secret }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="entry-email"><span data-toggle="tooltip" title="{{ help_email }}">{{ entry_email }}</span></label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_jovepay_email" value="{{ payment_jovepay_email }}" placeholder="{{ entry_email }}" id="entry-email" class="form-control"/>
                    {% if error_email %}
                    <div class="text-danger">{{ error_email }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                  <div class="col-sm-10">
                    <select name="payment_jovepay_status" id="input-status" class="form-control">
                      {% if payment_jovepay_status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_jovepay_sort_order" value="{{ payment_jovepay_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
                  </div>
                </div>
              </div>
              <div class="tab-pane" id="tab-status">
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-finished-status">{{ entry_finished_status }}</label>
                  <div class="col-sm-10">
                    <select name="payment_jovepay_finished_status_id" id="input-finished-status" class="form-control">
                      {% for order_status in order_statuses %}
                      {% if order_status.order_status_id == payment_jovepay_finished_status_id %}
                      <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                      {% else %}
                      <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                      {% endif %}
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-partially_paid-status">{{ entry_partially_paid_status }}</label>
                  <div class="col-sm-10">
                    <select name="payment_jovepay_partially_paid_status_id" id="input-partially_paid-status" class="form-control">
                      {% for order_status in order_statuses %}
                      {% if order_status.order_status_id == payment_jovepay_partially_paid_status_id %}
                      <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                      {% else %}
                      <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                      {% endif %}
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-confirming-status">{{ entry_confirming_status }}</label>
                        <div class="col-sm-10">
                          <select name="payment_jovepay_confirming_status_id" id="input-confirming-status" class="form-control">
                            {% for order_status in order_statuses %}
                            {% if order_status.order_status_id == payment_jovepay_confirming_status_id %}
                            <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                            {% else %}
                            <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-confirmed-status">{{ entry_confirmed_status }}</label>
                        <div class="col-sm-10">
                          <select name="payment_jovepay_confirmed_status_id" id="input-confirmed-status" class="form-control">
                            {% for order_status in order_statuses %}
                            {% if order_status.order_status_id == payment_jovepay_confirmed_status_id %}
                            <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                            {% else %}
                            <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-failed-status">{{ entry_failed_status }}</label>
                        <div class="col-sm-10">
                          <select name="payment_jovepay_failed_status_id" id="input-failed-status" class="form-control">
                            {% for order_status in order_statuses %}
                            {% if order_status.order_status_id == payment_jovepay_failed_status_id %}
                            <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                            {% else %}
                            <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-sending-status">{{ entry_sending_status }}</label>
                  <div class="col-sm-10">
                    <select name="payment_jovepay_sending_status_id" id="input-sending-status" class="form-control">
                      {% for order_status in order_statuses %}
                      {% if order_status.order_status_id == payment_jovepay_sending_status_id %}
                      <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                      {% else %}
                      <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                      {% endif %}
                      {% endfor %}
                    </select>
                  </div>
                </div>
              </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}