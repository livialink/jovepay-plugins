<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Jovepay\Checkout\Api\IpnManagementInterface" type="Jovepay\Checkout\Model\IpnManagement"/>
    <type name="Jovepay\Checkout\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Jovepay\Checkout\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">JovePayDebug</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Jovepay\Checkout\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
</config>
