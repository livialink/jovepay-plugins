<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="jove_pay" translate="label" type="text" sortOrder="50" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <label>JOVEpay</label>
                <resource>Jovepay_Checkout::config</resource>

                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1"
                       showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="is_testnet" translate="label comment" type="select" sortOrder="2" showInDefault="1"
                       showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Testnet Mode</label>
                    <comment>Enable to process payments on the JOVEpay test network.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="is_dark" translate="label comment" type="select" sortOrder="3" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Dark Mode Checkout</label>
                    <comment>Use the dark theme on the JOVEpay hosted payment page.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label comment" type="text" sortOrder="4" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Title</label>
                    <comment>Payment method title shown to customers at checkout.</comment>
                </field>
                <field id="merchant_id" translate="label comment" type="obscure" sortOrder="5" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Merchant ID</label>
                    <comment>Find this in jovepay.com under Payment Settings → API Keys. Re-save after upgrading to encrypt the value.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="ipn_secret" translate="label comment" type="obscure" sortOrder="6" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>IPN Secret</label>
                    <comment>Find this in jovepay.com under Payment Settings → Instant Payment Notifications. Re-save after upgrading to encrypt the value.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="allowspecific" translate="label" type="allowspecific" sortOrder="7" showInDefault="1"
                       showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Payment from Applicable Countries</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="8" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Payment from Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="status_order_placed" translate="label comment" type="select" sortOrder="9"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>New Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
                    <comment>Status after Magento checkout completes and before JOVEpay confirms payment.</comment>
                </field>
                <field id="status_order_paid" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Paid Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                    <comment>Status after JOVEpay confirms funds and notifies Magento via IPN.</comment>
                </field>
                <field id="debug" translate="label comment" type="select" sortOrder="11" showInDefault="1"
                       showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Debug</label>
                    <comment>Write detailed JOVEpay IPN messages to var/log/jovepay.log.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
